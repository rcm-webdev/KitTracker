# ── Required ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL where the app is accessible — no trailing slash
# Railway: your Railway-generated domain, e.g. https://kittracker.up.railway.app
# Local Docker: http://localhost:3000
APP_URL=https://your-app.up.railway.app

# ── Database ─────────────────────────────────────────────────────────────────
# Railway: automatically injected when Postgres service is linked — do not set
# Local Docker: set by docker-compose.yml internally — do not set here

# ── Port ─────────────────────────────────────────────────────────────────────
# Railway: automatically injected — do not set
# Local Docker: override the host port (default 3000)
# APP_PORT=3000
